#!/usr/bin/env bash
# Branch guard + shared checks. Bypass only with: git commit --no-verify
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [[ "$branch" == "main" && "${ALLOW_MAIN:-0}" != "1" ]]; then
  echo "pre-commit: direct commit on main blocked. Branch first (git switch -c <type>/<slug>)." >&2; exit 1
fi
exec "$(git rev-parse --show-toplevel)/scripts/check.sh" staged
