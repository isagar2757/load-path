#!/usr/bin/env bash
# Append a commit event to the shared Mongo log. Never blocks or fails a commit.
# SHA and branch are resolved now; the logger runs in the background and must not read HEAD later.
root=$(git rev-parse --show-toplevel)
sha=$(git rev-parse HEAD); branch=$(git rev-parse --abbrev-ref HEAD)
( cd "$root" && uv run --quiet scripts/adlc_log.py commit-hook --sha "$sha" --branch "$branch" >/dev/null 2>>"$(git rev-parse --git-dir)/adlc-log.err" ) &
exit 0
