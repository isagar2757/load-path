# Copy to .env (gitignored). Get the real value from Sagar privately, never in chat history shared outside the team, never in git.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
# Required: who you are in the shared log, sagar or arad (routes the relay inbox)
ADLC_AUTHOR=
# Optional: your own app database on the sandbox cluster (default capital). Set it when two people run the demo
# at the same time: `run_demo.py --reset` deletes every session in the database it runs on.
CAPITAL_DB=
# LLM provider key; provider set at the event (spec: open questions). Scripted mode needs none.
LLM_API_KEY=<key>
